{
  "name": "read-with-jev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "data:fetch": "node --import tsx scripts/fetch-data.ts",
    "data:prepare": "node --import tsx scripts/prepare.ts",
    "benchmark": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/benchmark.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "node --import tsx scripts/browser-smoke.ts",
    "library:prepare": "node --import tsx scripts/prepare-library.ts",
    "store:prepare": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/prepare-emotion-store.ts",
    "texts:prepare": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/prepare-custom-text-store.ts",
    "store:warm": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/warm-emotion-store.ts",
    "build:netlify": "npm run library:prepare && npm run store:prepare && npm run texts:prepare && npm run build",
    "test:library:browser": "node --import tsx scripts/browser-library-smoke.ts",
    "test:text:browser": "node --import tsx scripts/browser-custom-text.ts",
    "og:capture": "node --import tsx scripts/capture-og-image.ts",
    "demo:frames": "node --import tsx scripts/capture-demo-frames.ts",
    "demo:video": "node --import tsx scripts/encode-demo-video.ts",
    "library:import-top100": "node --import tsx scripts/import-top100.ts",
    "library:extract-casts": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/extract-casts.ts",
    "library:publish-top100": "node --import tsx scripts/publish-top100.ts",
    "library:status": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/library-status.ts",
    "affect:prepare": "python3 scripts/prepare-affect.py",
    "affect:benchmark": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/benchmark-affect.ts",
    "affect:highlights": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/benchmark-affect-highlights.ts"
  },
  "dependencies": {
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@headlessui/react": "2.2.10",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/auth-ui": "0.3.0-beta",
    "@neondatabase/serverless": "1.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@typesafe-ai/sdk": "0.6.0",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "motion": "13.2.0",
    "next": "16.3.4",
    "postcss": "8.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
