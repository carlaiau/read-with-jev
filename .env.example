TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Shared read-through cache for reader sentence scores (Neon Postgres). Use Neon's POOLED
# connection string, the one whose host contains "-pooler": the reader runs as many short-lived
# serverless instances, and the direct string is bounded by the compute's connection slots.
# Unset locally, the on-disk cache in data/cache/ is the only cache and the in-process limit
# is the only concurrency bound.
DATABASE_URL=
# Model calls allowed in flight across every instance at once, leased in Postgres. The
# in-process limit cannot bound this, because the platform runs many instances. Default 12.
JEV_MAX_CONCURRENT_CALLS=

# Absolute Open Graph/Twitter image URLs. Netlify's own URL is used when this is unset.
NEXT_PUBLIC_SITE_URL=

# Offline character/alias extraction only; never exposed to the reader.
OPENAI_API_KEY=
OPENAI_CAST_MODEL=gpt-5-mini-2025-08-07
